<?xml version="1.0" encoding="utf-8"?>
<!-- Por qué: El alcance dinámico de paquetes se asigna en tiempo de ejecución mediante setServiceInfo() para limitarse solo a las apps de mensajería habilitadas por el usuario -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged|typeViewScrolled|typeViewFocused|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:notificationTimeout="60"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description" />
