<?xml version="1.0" encoding="utf-8"?>
<!-- Por qué: Excluye explícitamente todos los datos privados (Android 11 e inferiores) aunque allowBackup esté desactivado -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
