<?xml version="1.0" encoding="utf-8"?>
<!-- Pastilla interactiva minimalista para traducir un mensaje individual al tocarlo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_draft_bubble_dark"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp"
    android:elevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pill_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_draft_badge_dark"
            android:contentDescription="@string/draft_switch_lang_desc"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:letterSpacing="0.03"
            android:textColor="#FF34D399"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/pill_btn_peek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_draft_badge_dark"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/pill_action_original"
            android:textColor="#FF94A3B8"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pill_btn_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_draft_badge_dark"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/pill_action_copy"
            android:textColor="#FF94A3B8"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="4dp" />

        <ImageView
            android:id="@+id/pill_btn_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_draft_close_btn_dark"
            android:contentDescription="@string/pill_close_desc" />
    </LinearLayout>

    <TextView
        android:id="@+id/pill_translated_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:paddingStart="0dp"
        android:paddingEnd="2dp"
        android:textColor="#FFF8FAFC"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:lineSpacingMultiplier="1.12"
        android:maxLines="6"
        android:ellipsize="end" />
</LinearLayout>
