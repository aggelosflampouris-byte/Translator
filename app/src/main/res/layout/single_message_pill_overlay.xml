<?xml version="1.0" encoding="utf-8"?>
<!-- Pastilla interactiva para traducir un mensaje individual seleccionado al tocarlo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_draft_bubble"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:elevation="8dp">

    <!-- Fila superior: etiqueta de idioma y acciones rápidas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pill_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_draft_badge"
            android:contentDescription="@string/draft_switch_lang_desc"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="⇄ EL"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/pill_btn_peek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_draft_badge"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Original"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pill_btn_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_draft_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Copy"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/pill_btn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="✕"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Texto traducido con tipografía nítida -->
    <TextView
        android:id="@+id/pill_translated_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#F8FAFC"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:maxLines="6"
        android:ellipsize="end" />
</LinearLayout>

