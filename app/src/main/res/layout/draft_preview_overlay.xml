<?xml version="1.0" encoding="utf-8"?>
<!-- Por qué: Píldora flotante minimalista con cierre vectorial y jerarquía limpia adaptable a tema y ancho -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/draft_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_draft_bubble_dark"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp"
    android:elevation="10dp">

    <LinearLayout
        android:id="@+id/draft_header_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/draft_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_draft_badge_dark"
            android:contentDescription="@string/draft_switch_lang_desc"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:letterSpacing="0.03"
            android:textColor="#FF60A5FA"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:id="@+id/draft_header_spacer"
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/draft_action_replace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_draft_action_btn"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:singleLine="true"
            android:text="@string/draft_action_replace"
            android:textColor="#FFFFFFFF"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/draft_action_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_draft_close_btn_dark"
            android:contentDescription="@string/draft_dismiss_desc" />
    </LinearLayout>

    <TextView
        android:id="@+id/draft_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="0dp"
        android:paddingEnd="2dp"
        android:textColor="#FFF8FAFC"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.12" />
</LinearLayout>
