<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/draft_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_draft_bubble"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:elevation="6dp">

    <!-- Indicador de dirección de idioma -->
    <TextView
        android:id="@+id/draft_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_draft_badge"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="⇄ RO"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="10dp" />

    <!-- Contenido traducido con tipografía optimizada para lectura -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/draft_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to replace in chat"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/draft_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F8FAFC"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif"
            android:maxLines="4"
            android:ellipsize="end"
            android:lineSpacingExtra="1.5dp" />
    </LinearLayout>

    <!-- Botón de reemplazo con acabado estilizado -->
    <TextView
        android:id="@+id/draft_action_replace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_draft_action_btn"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_marginStart="8dp"
        android:text="Replace"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Botón de cierre discreto -->
    <TextView
        android:id="@+id/draft_action_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_marginStart="4dp"
        android:text="✕"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
