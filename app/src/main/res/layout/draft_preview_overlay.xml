<?xml version="1.0" encoding="utf-8"?>
<!-- Por qué: Píldora flotante en dos zonas (cabecera compacta + texto completo) adaptable a ancho y tema del sistema -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/draft_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_draft_bubble_dark"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp"
    android:elevation="10dp">

    <!-- Fila superior: dirección de idioma interactiva, acción principal y cierre con área táctil cómoda -->
    <LinearLayout
        android:id="@+id/draft_header_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/draft_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_draft_badge_dark"
            android:contentDescription="@string/draft_switch_lang_desc"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="EL → RO"
            android:textColor="#FF34D399"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:id="@+id/draft_header_spacer"
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/draft_action_replace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_draft_action_btn"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:singleLine="true"
            android:text="@string/draft_action_replace"
            android:textColor="#FFFFFFFF"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/draft_action_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_draft_close_btn_dark"
            android:contentDescription="@string/draft_dismiss_desc"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FF94A3B8"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Vista previa completa del borrador traducido con interlineado nítido -->
    <TextView
        android:id="@+id/draft_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="0dp"
        android:paddingEnd="4dp"
        android:textColor="#FFF8FAFC"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />
</LinearLayout>
